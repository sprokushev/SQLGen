<Window x:Name="winJenkinsExec" x:Class="SQLGen.WinJenkinsExec"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SQLGen"
        xmlns:converters="clr-namespace:SQLGen"
        mc:Ignorable="d"
        Title="Выполнить в Jenkins" Height="800" Width="1400" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Visible" WindowStartupLocation="CenterScreen" Activated="winJenkinsExec_Activated" Closed="winJenkinsExec_Closed" >

    <Grid x:Name="mainGrid" Background="#FFE5E5E5">
        <Button x:Name="btUp" ToolTip="Поднять строку выше" Click="btUp_Click" HorizontalAlignment="Left" Margin="10,12,0,0" VerticalAlignment="Top" Width="23" Height="23">
            <Image Source="../Images/up.png"></Image>
        </Button>

        <Button x:Name="btDown" ToolTip="Опустить строку ниже" Click="btDown_Click" HorizontalAlignment="Left" Margin="40,12,0,0" VerticalAlignment="Top" Width="23" Height="23">
            <Image Source="../Images/down.png"></Image>
        </Button>

        <Button x:Name="btRun" Content="Выполнить задания Jenkins" HorizontalAlignment="Left" Margin="75,10,0,0" Width="250" Height="25" VerticalAlignment="Top" Click="btRun_Click"/>
        <Button x:Name="btCopyBad" HorizontalAlignment="Left" Margin="335,10,0,0" Height="24" Width="290" ToolTip="Скопировать в буфер ВСЕ лишние пункты (пустые имя файла, алиас или ветка)" Click="btCopyBad_Click" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal">
                <Image Source="../Images/clipboard.png"></Image>
                <TextBlock>Скопировать в буфер ВСЕ лишние пункты</TextBlock>
            </StackPanel>
        </Button>
        <Button x:Name="btDelBad" Content="Удалить ВСЕ лишние пункты" HorizontalAlignment="Left" Margin="635,10,0,0" Width="250" Height="25" VerticalAlignment="Top" Click="btDelBad_Click" ToolTip="Удалить ВСЕ лишние пункты (пустые имя файла, алиас или ветка)"/>
        <Button x:Name="btAllLog" Content="Общий лог" HorizontalAlignment="Left" Margin="895,10,0,0" Width="100" Height="25" VerticalAlignment="Top" Click="btAllLog_Click" />

        <Label Content="Фильтр по стенду:" HorizontalAlignment="Left" Margin="10,40,0,0" VerticalAlignment="Top" Width="113"/>
        <ComboBox x:Name="cbFilterStand" HorizontalAlignment="Left" Margin="130,42,0,0" VerticalAlignment="Top" Width="236" SelectionChanged="cbFilterStand_SelectionChanged"/>

        <DataGrid x:Name="dgList"
            AutoGenerateColumns="False" 
            Margin="0,75,0,0" 
            CanUserSortColumns="False" 
            HorizontalScrollBarVisibility="Visible" 
            VerticalScrollBarVisibility="Visible" 
            CanUserDeleteRows="False" 
            CanUserAddRows="False" 
            SelectionMode = "Single" 
                  
            SelectionChanged="dgList_SelectionChanged" 
            MouseDoubleClick="dgList_MouseDoubleClick" 
            CurrentCellChanged="dgList_CurrentCellChanged" 
            KeyDown="dgList_KeyDown" 
            PreviewKeyDown="dgList_PreviewKeyDown" 
            MouseDown="dgList_MouseDown"
            SelectionUnit="Cell"
        >
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="order" Header="N" Width="30" Binding="{Binding Order}" IsReadOnly="false" >
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Style.Triggers>
                                <!-- Если галочка стоит, красим ячейку в зеленый -->
                                <DataTrigger Binding="{Binding isExecuted}" Value="True">
                                    <Setter Property="Background" Value="LightGreen"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>

                <DataGridTextColumn x:Name="version" Header="Версия" Width="100" Binding="{Binding Version}" IsReadOnly="true" >
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Style.Triggers>
                                <!-- Если галочка стоит, красим ячейку в зеленый -->
                                <DataTrigger Binding="{Binding isExecuted}" Value="True">
                                    <Setter Property="Background" Value="LightGreen"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>

                <DataGridTextColumn x:Name="stand" Header="Стенд" Width="100" Binding="{Binding Stand}" IsReadOnly="true" >
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Style.Triggers>
                                <!-- Если галочка стоит, красим ячейку в зеленый -->
                                <DataTrigger Binding="{Binding isExecuted}" Value="True">
                                    <Setter Property="Background" Value="LightGreen"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>

                <DataGridTextColumn x:Name="project" Header="Проект" Width="150" Binding="{Binding Project}" IsReadOnly="true" >
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Style.Triggers>
                                <!-- Если галочка стоит, красим ячейку в зеленый -->
                                <DataTrigger Binding="{Binding isExecuted}" Value="True">
                                    <Setter Property="Background" Value="LightGreen"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>

                <DataGridTextColumn x:Name="filename" Header="Действие" Width="500" Binding="{Binding FileName}" IsReadOnly="true" >
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>

                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Style.Triggers>
                                <!-- Если галочка стоит, красим ячейку в зеленый -->
                                <DataTrigger Binding="{Binding isExecuted}" Value="True">
                                    <Setter Property="Background" Value="LightGreen"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </DataTrigger>

                                <!-- Если галочка НЕ стоит, красим ячейку в серый -->
                                <DataTrigger Binding="{Binding ExecutionMode}" Value="False">
                                    <Setter Property="Background" Value="LightGray"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>

                <DataGridTextColumn x:Name="alias" Header="Алиас" Width="150" Binding="{Binding Path=AliasName}" IsReadOnly="true" >
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Style.Triggers>
                                <!-- Если галочка стоит, красим ячейку в зеленый -->
                                <DataTrigger Binding="{Binding isExecuted}" Value="True">
                                    <Setter Property="Background" Value="LightGreen"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>

                <DataGridTextColumn x:Name="branch" Header="Ветка" Width="100" Binding="{Binding Path=Branch}" IsReadOnly="true" >
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Style.Triggers>
                                <!-- Если галочка стоит, красим ячейку в зеленый -->
                                <DataTrigger Binding="{Binding isExecuted}" Value="True">
                                    <Setter Property="Background" Value="LightGreen"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>

                <DataGridCheckBoxColumn x:Name="executionmode" Header="Выполнить?" Width="80" Binding="{Binding Path=ExecutionMode, UpdateSourceTrigger=PropertyChanged}" >
                    <DataGridCheckBoxColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <!-- Цвет по умолчанию -->
                            <Setter Property="Background" Value="Transparent"/>

                            <Style.Triggers>
                                <!-- Если галочка стоит, красим ячейку в зеленый -->
                                <DataTrigger Binding="{Binding isExecuted}" Value="True">
                                    <Setter Property="Background" Value="LightGreen"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridCheckBoxColumn.CellStyle>
                </DataGridCheckBoxColumn>

                <DataGridCheckBoxColumn x:Name="isexecuted" Header="Готово?" Width="60" Binding="{Binding Path=isExecuted, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="true" >
                    <DataGridCheckBoxColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <!-- Цвет по умолчанию -->
                            <Setter Property="Background" Value="Transparent"/>

                            <Style.Triggers>
                                <!-- Если галочка стоит, красим ячейку в зеленый -->
                                <DataTrigger Binding="{Binding isExecuted}" Value="True">
                                    <Setter Property="Background" Value="LightGreen"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridCheckBoxColumn.CellStyle>
                </DataGridCheckBoxColumn>

            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Удалить строку" Click="btDelRow_Click" />
                    <Separator/>
                    <MenuItem Header="Снять флаг успешного выполнения" Click="btCleanIsExecuted_Click" />
                    <Separator/>
                    <MenuItem Header="Выполнять ПО это задание включительно" Click="btRunTo_Click" />
                    <MenuItem Header="Выполнять НАЧИНАЯ с этого задания" Click="btRunFrom_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </Grid>
</Window>
